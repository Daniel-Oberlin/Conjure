# Conjure configuration — copy to `.env` (git-ignored) and fill in.
#   cp .env.example .env
# Provider selection is documented in docs/providers.md.

# --- Director LLM roster (cloud) ---
# The director needs at least one of these keys. Set several to get the switchable roster: say "let
# me talk to Gemini" to hand over, or "Gemini, ..." to address one for a single turn. The roster
# (casual names → vendors) is defined in one place: conjure/llm.py ROSTER.
#   Claude  ← ANTHROPIC_API_KEY   https://console.anthropic.com  (API billing, ≠ Claude.ai sub)
#   Gemini  ← GOOGLE_API_KEY      https://aistudio.google.com    (free to start)
#   Chat    ← OPENAI_API_KEY      https://platform.openai.com     (also adds an image generator)
#   Grok    ← XAI_API_KEY         https://console.x.ai            (also adds an image generator)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# --- Provider selection ---
CONJURE_STT=whisper     # whisper (local) | deepgram | assemblyai | ...
CONJURE_TTS=kokoro      # kokoro (local) | piper (local, needs server) | cartesia | elevenlabs
CONJURE_LLM=claude      # active-at-startup director: claude | gemini | chat | grok  (needs the matching key)
CONJURE_LLM_MODEL=claude-sonnet-4-6     # Claude director model (claude-haiku-4-5 for cheaper/faster)
CONJURE_GEMINI_MODEL=gemini-2.5-flash   # Gemini director model (when "Gemini" is in the roster)
CONJURE_OPENAI_DIRECTOR_MODEL=gpt-4.1   # OpenAI "Chat" director model (tool-calling capable)
CONJURE_XAI_DIRECTOR_MODEL=grok-4       # xAI "Grok" director model (grok-4.x / grok-3 also valid)

# --- Shell wake word ---
# The word that turns a spoken line into a COMMAND ("conjure, where am I") rather than content. STT
# doesn't know it and guesses at something phonetically near, so the list carries the mis-hearings too;
# the first entry is the canonical one. Add what you actually hear go wrong — every entry must be a
# NON-word, or it will swallow ordinary speech that happens to start with it.
# Default: conjure,coinjure,conjur,conjour,konjure   (also settable as "wake_words" in settings.json)
# CONJURE_WAKE_WORDS=conjure,coinjure,conjur,conjour,konjure
#
# The VOICE client's mic-activation word is a DIFFERENT word, and there is NO default — the gate is off
# unless you name one with --wake-word (which takes a comma-separated list, so mis-hearings ride along:
# --wake-word computer,computa). Set this only if you want a standing default without the flag.
# The mic gate strips its word before the shell sees the line, so it must not be one of CONJURE_WAKE_WORDS
# above — "computer conjure where am I" is how you reach the shell by voice. An overlap is refused at
# startup.   (also settable as "voice_wake_words" in settings.json)
# CONJURE_VOICE_WAKE_WORDS=computer,computa

# --- Server / connectivity ---
CONJURE_HOST=0.0.0.0
CONJURE_PORT=8080
CONJURE_URL=http://localhost:8080   # where the MCP server / voice loop reach the world server

# --- Assets (Phase 3): Poly Pizza free 3D-model API ---
# Free developer token from https://poly.pizza/docs/api/v1.1 (sign in; no payment).
POLY_PIZZA_API_KEY=

# --- Image generation ---
# Every configured generator is available at once; the MCP server picks a hard-coded best default per
# task (Gemini for generate/edit/outpaint/skybox; OpenAI when transparency is requested), and the
# director can name one explicitly. Gemini ← GOOGLE_API_KEY, OpenAI ("Chat") ← OPENAI_API_KEY (above).
GOOGLE_API_KEY=
CONJURE_IMAGE_MODEL=gemini-2.5-flash-image  # Gemini paintings/photos (cheap, fast)
CONJURE_SKYBOX_MODEL=gemini-3-pro-image     # Gemini skyboxes wrap the whole view → higher-res model
CONJURE_SKYBOX_SIZE=4K                       # 1K | 2K | 4K (Pro model only)
CONJURE_OPENAI_IMAGE_MODEL=gpt-image-1       # OpenAI generator (strong text/typography, transparency)
CONJURE_XAI_IMAGE_MODEL=grok-imagine-image-2.0  # Grok generator (generate-only; XAI_API_KEY above)

# --- Optional: only needed if you switch to cloud speech ---
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
# ELEVENLABS_API_KEY=
