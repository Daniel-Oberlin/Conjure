# Conjure configuration — copy to `.env` (git-ignored) and fill in.
#   cp .env.example .env
# Provider selection is documented in docs/providers.md.

# --- Director LLM (cloud) ---
# Required when CONJURE_LLM=claude. Get a key at https://console.anthropic.com
# (this is the API — billing/credits required, separate from a Claude.ai subscription).
ANTHROPIC_API_KEY=

# --- Provider selection ---
CONJURE_STT=whisper     # whisper (local) | deepgram | assemblyai | ...
CONJURE_TTS=kokoro      # kokoro (local) | piper (local, needs server) | cartesia | elevenlabs
CONJURE_LLM=claude      # claude | openai | gemini | ollama
CONJURE_LLM_MODEL=claude-sonnet-4-6   # director model (e.g. claude-haiku-4-5 for cheaper/faster)

# --- Server / connectivity ---
CONJURE_HOST=0.0.0.0
CONJURE_PORT=8080
CONJURE_URL=http://localhost:8080   # where the MCP server / voice loop reach the world server

# --- Optional: only needed if you switch to cloud speech or add roster LLMs ---
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
# ELEVENLABS_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
