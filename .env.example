# Conjure configuration — copy to `.env` (git-ignored) and fill in.
#   cp .env.example .env
# Provider selection is documented in docs/providers.md.

# --- Director LLM roster (cloud) ---
# The director needs at least one of these. Set both to get the switchable roster: say "let me talk
# to Gemini" to hand over, or "Gemini, ..." to address one for a single turn. CONJURE_LLM picks the
# one that's active at startup. Anthropic key: https://console.anthropic.com (API billing, separate
# from a Claude.ai subscription). Google key: https://aistudio.google.com (free to start).
ANTHROPIC_API_KEY=

# --- Provider selection ---
CONJURE_STT=whisper     # whisper (local) | deepgram | assemblyai | ...
CONJURE_TTS=kokoro      # kokoro (local) | piper (local, needs server) | cartesia | elevenlabs
CONJURE_LLM=claude      # active-at-startup director: claude | gemini  (needs the matching key)
CONJURE_LLM_MODEL=claude-sonnet-4-6   # Claude director model (claude-haiku-4-5 for cheaper/faster)
CONJURE_GEMINI_MODEL=gemini-2.5-flash # Gemini director model (used when "Gemini" is in the roster)

# --- Server / connectivity ---
CONJURE_HOST=0.0.0.0
CONJURE_PORT=8080
CONJURE_URL=http://localhost:8080   # where the MCP server / voice loop reach the world server

# --- Assets (Phase 3): Poly Pizza free 3D-model API ---
# Free developer token from https://poly.pizza/docs/api/v1.1 (sign in; no payment).
POLY_PIZZA_API_KEY=

# --- Image generation (Phase 4): Google Gemini ("Nano Banana") ---
# Default provider; great at editing + outpainting. Key from https://aistudio.google.com (free to start).
GOOGLE_API_KEY=
CONJURE_IMAGE_PROVIDER=gemini              # gemini | (more generators plug in: openai, ...)
CONJURE_IMAGE_MODEL=gemini-2.5-flash-image # paintings/photos (cheap, fast)
CONJURE_SKYBOX_MODEL=gemini-3-pro-image    # skyboxes wrap the whole view → higher-res model
CONJURE_SKYBOX_SIZE=4K                      # 1K | 2K | 4K (Pro model only)
# Alternative image provider (OpenAI gpt-image-1): set CONJURE_IMAGE_PROVIDER=openai + this key.
# OPENAI_API_KEY=

# --- Optional: only needed if you switch to cloud speech or add roster LLMs ---
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
# ELEVENLABS_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
