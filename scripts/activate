# This file must be sourced so it can modify the current shell environment.
_is_sourced=0
if [ -n "${ZSH_VERSION:-}" ]; then
	case $ZSH_EVAL_CONTEXT in
		*:file) _is_sourced=1 ;;
	esac
elif [ -n "${BASH_VERSION:-}" ]; then
	if [ "${BASH_SOURCE[0]}" != "$0" ]; then
		_is_sourced=1
	fi
fi

if [ "$_is_sourced" -ne 1 ]; then
	echo "This script must be sourced: source ./activate"
	exit 1
fi
unset _is_sourced

source .venv/bin/activate
